# Copy to .env for local runs (never commit .env). On Render, set these in the dashboard.

# --- Database (Supabase -> Project Settings -> Database -> Connection string -> JDBC, SESSION pooler) ---
DATABASE_URL=jdbc:postgresql://aws-0-ap-south-1.pooler.supabase.com:5432/postgres?sslmode=require
DATABASE_USERNAME=postgres.your-project-ref
DATABASE_PASSWORD=your-database-password
DB_POOL_SIZE=3

# --- Security ---
# Generate: openssl rand -base64 48
JWT_SECRET=replace-with-a-long-random-string-at-least-32-chars
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=14
# After you create your own account, set this to false so nobody else can sign up.
REGISTRATION_ENABLED=true
# Accounts with these emails become ADMIN when they register (comma-separated).
ADMIN_EMAILS=you@example.com

# --- Frontend origin(s) allowed by CORS (comma-separated, no trailing slash) ---
CORS_ALLOWED_ORIGINS=http://localhost:5173,https://code-quest-web.onrender.com
APP_DEFAULT_TIMEZONE=Asia/Kolkata

# --- AI (used from Phase 3; the app works fully with AI_ENABLED=false) ---
AI_ENABLED=false
OPENROUTER_API_KEY=
# Set the exact current Nemotron ":free" model id from https://openrouter.ai/models
OPENROUTER_MODEL=
OPENROUTER_FALLBACK_MODELS=
AI_DAILY_LIMIT_PER_USER=30
AI_MAX_OUTPUT_TOKENS=1500
AI_TIMEOUT_SECONDS=60
